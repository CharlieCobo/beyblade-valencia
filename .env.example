# Configuración web del proyecto de Firebase (consola > Configuración del proyecto > Tus apps > SDK).
# Es pública por diseño: la seguridad la dan las reglas de Firestore (firestore.rules).
# Copia este fichero como .env y rellena los valores. Las cuatro variables son obligatorias.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
